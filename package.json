{
  "name": "pipaltreespaces",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/validate-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "validate-data": "tsx scripts/validate-data.ts",
    "test": "vitest run && tsx scripts/validate-data.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@next/mdx": "^15.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^3.80.0"
  }
}
